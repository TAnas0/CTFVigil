# ==============================================================================
# CTFVigil Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your environment:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# Required Settings
# ------------------------------------------------------------------------------

# Discord Bot Token
# Obtain from Discord Developer Portal (https://discord.com/developers/applications):
#   1. Select your Application -> "Bot" tab.
#   2. Click "Reset Token" and paste the token below.
#   3. Enable "Message Content Intent" and "Server Members Intent" under Privileged Gateway Intents.
DISCORD_TOKEN=your_discord_bot_token_here

# ------------------------------------------------------------------------------
# Infrastructure & Cache Settings (Optional)
# ------------------------------------------------------------------------------

# Redis connection URL
# Used as both the Celery task broker/backend and the shared RedisCache layer.
# Default for Docker Compose stack: redis://redis:6379/0
# Default for native local dev without Docker: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Notification & Webhook Integrations (Optional)
# ------------------------------------------------------------------------------

# Discord Webhook URL for Automated Event Digests
# When set, periodic background workers (Celery Beat) dispatch automated CTFtime
# upcoming event summaries directly to this channel.
#
# How to create a Discord Webhook:
#   1. In your Discord server, right-click your chosen alerts/digest text channel.
#   2. Select "Edit Channel" (gear icon) -> "Integrations" -> "Webhooks".
#   3. Click "New Webhook", name it "CTFVigil Digest", and click "Copy Webhook URL".
#   4. Paste the full URL below (leave blank or commented out to disable).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

